  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:content && npm run check:budget && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
